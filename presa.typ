#let ink = rgb("#14232E")
#let teal = rgb("#0F6B76")
#let orange = rgb("#B84E17")
#let blue = rgb("#2F4F8F")
#let olive = rgb("#5E6B1F")
#let plum = rgb("#8A3D6B")
#let ochre = rgb("#8A6A10")
#let grey = rgb("#4F5B65")
#let line-c = rgb("#D9D3C3")
#set text(font: "DejaVu Sans", size: 17pt, lang: "ru", fill: ink)
#set par(leading: 0.62em, justify: false)
#let code-s(x) = text(font: "DejaVu Sans Mono", size: 0.92em, fill: teal)[#x]
#let blist(body) = {
  set list(marker: text(fill: orange)[▪], body-indent: 9pt, spacing: 9pt)
  block(above: 12pt, body)
}
#let sub(x) = block(above: 12pt, below: 6pt, text(fill: teal, weight: "bold", size: 15.5pt, x))
#let note(x) = block(width: 100%, fill: ink, radius: 5pt, inset: (x: 14pt, y: 10pt), above: 12pt, text(fill: paper, size: 15.5pt, x))
#let tbl(widths, head, ..rows) = block(above: 8pt, below: 6pt, table(
  columns: widths, stroke: none, inset: (x: 8pt, y: 6pt),
  fill: (_, y) => if y == 0 { ink } else if calc.odd(y) { card } else { none },
  table.header(..head.map(h => text(fill: paper, weight: "bold", size: 14pt, h))),
  ..rows.pos().map(c => text(size: 14.5pt, c)),
))
#let level(c, title, body) = block(width: 100%, stroke: (left: 6pt + c), fill: card, inset: (x: 14pt, y: 9pt), radius: 3pt,
  grid(columns: (170pt, 1fr), column-gutter: 14pt, text(weight: "bold", fill: c, size: 14pt, title), text(size: 14.5pt, body)))
#let chain(steps) = block(above: 8pt, below: 8pt, {
  let cells = ()
  for (i, s) in steps.enumerate() {
    cells.push(block(fill: card, stroke: 1pt + teal, radius: 4pt, inset: 8pt, width: 100%, align(center, text(size: 14pt, s))))
    if i < steps.len() - 1 { cells.push(text(fill: orange, size: 18pt, weight: "bold")[→]) }
  }
  grid(columns: range(steps.len() * 2 - 1).map(i => if calc.even(i) { 1fr } else { auto }), column-gutter: 5pt, align: horizon, ..cells)
})
#let slide(team, first, part, title, n, body) = page(width: 960pt, height: 540pt, margin: 0pt, fill: paper)[
  #block(width: 100%, height: 100%, inset: (x: 48pt, top: 24pt, bottom: 0pt))[
    #grid(columns: (1fr, auto), align: horizon + left,
      [#text(font: "DejaVu Sans Mono", size: 11pt, fill: teal, weight: "bold")[#upper(part)] \ #v(1pt) #text(font: "DejaVu Serif", weight: "bold", size: 24pt)[#title]],
      if team == none { [] } else if first { box(fill: orange, radius: 4pt, inset: (x: 14pt, y: 8pt), text(fill: white, weight: "bold", size: 17pt)[КОМАНДА #team]) } else { text(fill: grey, size: 12pt)[Команда #team] })
    #v(4pt)
    #line(length: 100%, stroke: 1pt + line-c)
    #v(2pt)
    #context {
      let h = measure(block(width: 864pt, body)).height
      if h > 378pt { place(top + center, text(fill: red, weight: "bold", size: 20pt)[OVERFLOW s#n #h]) }
    }
    #block(width: 100%, height: 378pt, body)
  ]
  #place(bottom + left, dx: 48pt, dy: -14pt, text(size: 10pt, fill: grey)[ISO/IEC/IEEE 29119 · конспект])
  #place(bottom + right, dx: -48pt, dy: -14pt, text(size: 10pt, fill: grey)[#context counter(page).display()])
]

#page(width: 960pt, height: 540pt, margin: 0pt, fill: ink)[
